# Reference only: the current scripts do not automatically load .env files.
# Set these variables in the shell before launching UrbanEye.
HF_TOKEN=YOUR_HUGGING_FACE_TOKEN
HF_PROVIDER=featherless-ai
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_STT_MODEL=openai/whisper-large-v3
URBANEYE_VL_MODEL=Qwen/Qwen2.5-VL-72B-Instruct:ovhcloud
URBANEYE_YOLO_BACKUP_MODE=never
URBANEYE_CV_API_BASE=http://127.0.0.1:5000
